{{!
    @template mod_videolesson/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videolesson-report">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2>{{#str}}report, videolesson{{/str}}</h2>
            <p class="mb-0">{{name}}</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" href="{{{viewurl}}}">{{#str}}backtolesson, videolesson{{/str}}</a>
            {{#canmanage}}<a class="btn btn-secondary" href="{{{manageurl}}}">{{#str}}
                managechapters, videolesson{{/str}}</a>{{/canmanage}}
        </div>
    </div>
    {{#hasstudents}}
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle videolesson-report-table">
                <thead>
                <tr>
                    <th scope="col">{{#str}}student, videolesson{{/str}}</th>
                    <th scope="col">{{#str}}overallprogress, videolesson{{/str}}</th>
                    {{#chapters}}
                        <th scope="col"><span class="d-block">{{title}}</span><small>{{time}}{{#required}}
                            · {{#str}}required, videolesson{{/str}}{{/required}}</small></th>{{/chapters}}
                    <th scope="col">{{#str}}actions, core{{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#students}}
                    <tr>
                        <th scope="row"><a href="{{{profileurl}}}">{{fullname}}</a></th>
                        <td>
                            <strong>{{percent}}%</strong>
                            <span class="d-block small">{{status}}</span>
                        </td>
                        {{#chapters}}
                            <td>
                                <strong>{{percent}}%</strong>
                                <span class="d-block small">{{status}}</span>
                            </td>
                        {{/chapters}}
                        <td>{{#canreset}}<a class="btn btn-sm btn-outline-danger" href="{{{reseturl}}}">{{#str}}
                            resetprogress, videolesson{{/str}}</a>{{/canreset}}</td>
                    </tr>
                {{/students}}
                </tbody>
            </table>
        </div>
    {{/hasstudents}}
    {{^hasstudents}}
        <div class="alert alert-info">{{#str}}noenrolledusers, videolesson{{/str}}</div>{{/hasstudents}}
</div>
